# 日落海景 — JSONL 操作脚本，paint-cli script 一次连接跑完
# 使用 {{layerId}} 模板：会被当前 active layer id 替换
# 用 {{layer:N}} 引用第 N 个 layer.create 返回的 id（0-indexed）

# 先获取默认 layer，把它当 sky
{"method": "layer.rename", "params": {"layerId": "{{layerId}}", "name": "sky"}}

# 创建另外 3 个 layer
{"method": "layer.create", "params": {"name": "sea"}}
{"method": "layer.create", "params": {"name": "mountains"}}
{"method": "layer.create", "params": {"name": "foreground"}}

