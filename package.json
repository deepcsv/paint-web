{
  "name": "paint-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, versioned Canvas2D painting runtime for human and AI artists",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.14.0",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "dev": "tsx watch --ignore '*.timestamp-*' --ignore 'data/**' --ignore 'dist/**' --ignore 'dist-server/**' server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "cli": "tsx cli/paint-cli.ts",
    "cli:build": "tsc -p tsconfig.cli.json && chmod +x dist-cli/cli/paint-cli.js",
    "test": "vitest run",
    "test:canvas": "vitest run tests/stamp-engine.test.ts tests/stroke-planner.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.cli.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "commander": "15.0.0",
    "perfect-freehand": "1.2.3",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.2",
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
